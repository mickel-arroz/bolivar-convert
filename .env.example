# Copia este archivo como `.env` y rellena los valores. El `.env` real está
# ignorado por git; este ejemplo existe para documentar qué variables hacen falta.
#
# Ninguna de estas claves debe llevar el prefijo NEXT_PUBLIC_ salvo las de
# Supabase, que son públicas por diseño: ese prefijo las expone al navegador.

# ─── Stitch (herramienta de diseño, vía MCP) ───
# Opcional y ajena a la app: ningún archivo del repo la lee. Está aquí porque
# vive en el mismo .env que el resto. Si no usas Stitch, déjala vacía.
STITCH_API_KEY=

# ─── Upstash Redis (caché del historial de tasas) ───
# console.upstash.com → tu base de datos → REST API.
# Opcional: `getRedis()` devuelve null si falta alguna de las dos y la app sigue
# funcionando sin historial cacheado (lib/rates.server.ts).
# Los scrapers de GitHub Actions las necesitan como secretos del repo.
UPSTASH_REDIS_REST_URL=https://TU-BASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token-rest

# ─── Supabase (autenticación + base de datos) ───
# Panel del proyecto → Project Settings → Data API / API Keys.
# Obligatorias: sin ellas no hay sesión ni billetera en la nube.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# ─── Google AI Studio (consejos semanales) ───
# aistudio.google.com/apikey → Create API key.
# Solo servidor: el navegador nunca habla con Google.
# Opcional: sin ella la app funciona igual y muestra los consejos genéricos.
GOOGLE_AI_API_KEY=
