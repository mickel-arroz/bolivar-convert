# ─── Supabase (autenticación + base de datos) ───
# Panel del proyecto → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# ─── Upstash Redis (tasas BCV/Binance — ya existente) ───
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# ─── Google AI Studio (consejos semanales) ───
# aistudio.google.com → Get API key. Solo servidor: el navegador nunca habla con Google.
# Sin esta clave la app funciona igual y muestra los consejos genéricos.
# GOOGLE_AI_API_KEY=...
